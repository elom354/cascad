# Cascad LLM attribution baselines
#
# DeepSeek is required by `cascad compare-attribution`.
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI is optional. When this key is non-empty, the same command executes
# both DeepSeek and OpenAI on matched prompts and observable traces.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=none

# Optional read token for Hugging Face Hub downloads. Both registered local
# models are public, so this may remain empty.
HF_TOKEN=
